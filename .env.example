# ChessMart Environment Configuration
SECRET_KEY=django-insecure-chessmart-key-for-dev-use-only
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL Database Configuration
# Set USE_POSTGRES=True once PostgreSQL service is running and chessmart_db is created
USE_POSTGRES=False
DB_NAME=chessmart_db
DB_USER=postgres
DB_PASSWORD=postgresql
DB_HOST=localhost
DB_PORT=5432
